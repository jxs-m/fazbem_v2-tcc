<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Security headers
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://unpkg.com https://sdk.mercadopago.com https://http2.mlstatic.com https://*.mlstatic.com https://*.mercadopago.com https://*.mercadolibre.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com https://http2.mlstatic.com https://*.mlstatic.com https://*.mercadopago.com; img-src 'self' data: blob: https://unpkg.com https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://*.openstreetmap.org https://http2.mlstatic.com https://*.mlstatic.com https://*.mercadopago.com https://*.mercadolibre.com; font-src 'self' data: https://fonts.gstatic.com https://http2.mlstatic.com https://*.mlstatic.com; connect-src 'self' https://*.tile.openstreetmap.org https://tile.openstreetmap.org https://nominatim.openstreetmap.org https://router.project-osrm.org https://api.mercadopago.com https://*.mercadopago.com https://events.mercadopago.com https://http2.mlstatic.com https://*.mlstatic.com https://*.mercadolibre.com https://api.mercadolibre.com; frame-src 'self' https://*.mercadopago.com https://www.mercadopago.com https://*.mlstatic.com https://http2.mlstatic.com https://*.mercadolibre.com; worker-src 'self' blob: https://*.mercadopago.com https://*.mlstatic.com https://http2.mlstatic.com; child-src 'self' blob: https://*.mercadopago.com https://*.mlstatic.com https://http2.mlstatic.com;"
